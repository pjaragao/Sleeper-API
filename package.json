{
  "name": "sleeper-fantasy-assistant",
  "version": "1.0.0",
  "description": "AI-powered fantasy football assistant integrating with Sleeper API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrations/run.ts",
    "db:seed": "tsx src/migrations/seed.ts",
    "sync:players": "tsx src/scripts/sync-players.ts",
    "sync:all": "tsx src/scripts/sync-all.ts",
    "kb:sync": "tsx src/scripts/kb-sync.ts",
    "kb:generate": "tsx src/scripts/kb-generate.ts",
    "kb:all": "npm run db:migrate && npm run kb:sync",
    "bot:schedule": "tsx src/scripts/test-schedule.ts",
    "bot:triggers": "tsx src/scripts/test-triggers.ts"
  },
  "keywords": [
    "sleeper",
    "fantasy",
    "football",
    "nfl",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.11.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
