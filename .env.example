# Database Configuration
# Options: sqlite (default) | supabase
DB_PROVIDER=sqlite

# SQLite (local development)
SQLITE_PATH=./data/sleeper.db

# Supabase (future production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# Server Configuration
PORT=3001
NODE_ENV=development

# Sleeper API (no auth needed, but we track rate limits)
SLEEPER_API_BASE_URL=https://api.sleeper.app/v1
SLEEPER_API_RATE_LIMIT=1000

# Sync Schedule (cron expressions)
PLAYERS_SYNC_CRON=0 4 * * *
LEAGUES_SYNC_CRON=0 5 * * *
TRENDING_SYNC_CRON=0 * * * *

# AI Configuration (for future use)
# OPENAI_API_KEY=your_key_here
# AI_PROVIDER=openai
